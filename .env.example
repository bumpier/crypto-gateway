# ---------------------------------------------------------------------------
# Crypto Payment Gateway — configuration
# Copy to `.env` and fill in. Never commit your real .env.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000

# How often (ms) to poll each blockchain for incoming payments.
POLL_INTERVAL_MS=30000

# Unpaid payments are marked "expired" after this many minutes.
EXPIRY_MINUTES=30

# ---------------------------------------------------------------------------
# Webhook — fired (POST) when a payment reaches the required confirmations.
# If WEBHOOK_SECRET is set, requests carry an HMAC header:
#   X-Webhook-Signature: sha256=<hex(hmac_sha256(secret, rawBody))>
# ---------------------------------------------------------------------------
WEBHOOK_URL=
WEBHOOK_SECRET=

# Token required for admin endpoints (GET /payments, POST /webhook-test).
# Pass it as the `x-admin-token` header or `?token=` query param.
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Receiving keys / addresses. Leave blank to disable a currency.
#
# BTC/ETH derive a UNIQUE address per payment from an account-level extended
# public key (xpub). Export the ACCOUNT xpub:
#   BTC: m/84'/0'/0'  (native segwit; xpub/ypub/zpub all accepted)
#   ETH: m/44'/60'/0'
# The gateway derives the external chain 0/index for each payment, so your
# private keys never touch this server.
#
# USDT is STILL a single static address (see README "Security & limitations").
# XMR derives a unique subaddress per payment via monero-wallet-rpc (below).
# ---------------------------------------------------------------------------
BTC_XPUB=
ETH_XPUB=
USDT_ADDRESS=

# ---------------------------------------------------------------------------
# Confirmation thresholds (a payment is "confirmed" at/after this depth).
# ---------------------------------------------------------------------------
CONFIRMATIONS_BTC=1
CONFIRMATIONS_ETH=12
CONFIRMATIONS_USDT=1
CONFIRMATIONS_XMR=10

# ---------------------------------------------------------------------------
# Bitcoin — Blockstream Esplora (no API key needed).
# ---------------------------------------------------------------------------
BLOCKSTREAM_API=https://blockstream.info/api

# ---------------------------------------------------------------------------
# Ethereum — Etherscan API v2 (free key from https://etherscan.io/myapikey).
# ---------------------------------------------------------------------------
ETHERSCAN_API=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# USDT TRC-20 — TronGrid (free key from https://www.trongrid.io/).
# Default contract is mainnet USDT.
# ---------------------------------------------------------------------------
TRONGRID_API_KEY=
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ---------------------------------------------------------------------------
# Monero — local monero-wallet-rpc JSON-RPC endpoint.
# Start the wallet RPC with --disable-rpc-login (this client does not do digest auth).
# ---------------------------------------------------------------------------
XMR_WALLET_RPC=http://127.0.0.1:18082/json_rpc

# Monero account to create per-payment subaddresses under (usually 0).
XMR_ACCOUNT_INDEX=0

# Optional: override SQLite location.
# DB_PATH=./gateway.db
